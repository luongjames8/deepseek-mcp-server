{
  "name": "deepseek-cli",
  "version": "2.0.0",
  "description": "Streaming DeepSeek CLI with caller-overridable thinking/model/effort. Replaces the deepseek-agent-mcp pattern with a CLI Claude orchestrates directly.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "deepseek": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek",
    "cli",
    "llm",
    "ai",
    "claude-code",
    "streaming",
    "agentic"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luongjames8/deepseek-mcp-server"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^14.0.3",
    "dotenv": "^16.4.0",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
